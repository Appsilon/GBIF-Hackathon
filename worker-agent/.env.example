GH_TOKEN=
ANTHROPIC_API_KEY=
REPO=owner/name

# Posit Connect, used by deploy/deploy.R to publish a preview build
# before the PR is opened
CONNECT_SERVER=
CONNECT_API_KEY=
CONNECT_ACCOUNT=
# optional, see deploy/deploy.R for default
APP_BASE_NAME=

LABEL_READY=agent-ready
LABEL_IN_PROGRESS=agent-in-progress
LABEL_DONE=agent-done
LABEL_FAILED=agent-failed

# standard cron expression, evaluated inside the container
POLL_CRON=*/5 * * * *

# optional, defaults to the CLI's default model if unset
CLAUDE_MODEL=
